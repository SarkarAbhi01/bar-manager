DATABASE_URL=postgres://postgres:postgres@localhost:5432/barmanager
# URL customers' phones open from the QR (your PC's LAN address, or the public domain)
PUBLIC_URL=http://localhost:5173
PORT=4000
# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=change-me
# Platform owner (SuperAdmin). Created only when no SuperAdmin exists yet. CHANGE the password after first login.
SUPER_USER=superadmin
SUPER_PASS=super123
# Set to 1 when running behind Nginx / Caddy / a load balancer (so rate limits use the real customer IP)
# TRUST_PROXY=1
